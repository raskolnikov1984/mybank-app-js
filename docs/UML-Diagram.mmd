classDiagram
    direction TB

    %% ===== Dominio: shared =====
    class Money {
        <<value object>>
        -#amount: number
        -#currency: Currency
        +getAmount() number
        +getCurrency() Currency
        +equals(other) boolean
        +add(other) Money
        +subtract(other) Money
        +isGreaterThan(other) boolean
        +isLessThan(other) boolean
        +isPositive() boolean
    }
    class InstallmentPlan {
        <<value object>>
        +quote(capital: Money, installments)$ InstallmentQuote
    }
    class Currency {
        <<enumeration>>
        COLOMBIAN_PESO
    }

    %% ===== Dominio: account =====
    class Account {
        <<abstract>>
        -#balance: Money
        -#creditUsed: Money
        -#movements: Movement[]
        +accountType()* AccountType
        +typeName()* string
        +creditLimit()* Money
        +describe()* string
        +supportsMonthlyStatement() boolean
        +monthlyStatement() StatementResult
        +insufficientFundsError() DomainError
        +getBalance() Money
        +getCreditUsed() Money
        +getAvailableCredit() Money
        +getAvailableFunds() Money
        +hasOpenPosition() boolean
        +getMovements() Movement[]
        +withdrawFunds(amount: Money) void
        +depositFunds(amount: Money) void
        +assertCanDeposit(amount: Money) void
        +toSnapshot() object
        +restoreState(account, snapshot)$ void
    }
    class SavingsAccount {
        +creditLimit() Money
        +withdrawFunds(amount: Money) void
        +describe() string
    }
    class CheckingAccount {
        +creditLimit() Money
        +describe() string
    }
    class CreditCard {
        -#limit: Money
        +getDebt() Money
        +creditLimit() Money
        +withdrawFunds(amount: Money) void
        +assertCanDeposit(amount: Money) void
        +supportsInstallments() boolean
        +purchaseInInstallments(amount, installments) InstallmentQuote
        +insufficientFundsError() CreditLimitExceededError
        +toSnapshot() object
        +describe() string
    }
    class Movement {
        <<entity>>
        -#type: MovementType
        -#amount: Money
        -#date: Date
        -#installments: InstallmentData
        +getType() MovementType
        +getAmount() Money
        +getDate() Date
        +getInstallments() InstallmentData
    }
    class MovementType {
        <<enumeration>>
        WITHDRAW
        DEPOSIT
        INTEREST
        TRANSFER_OUT
        TRANSFER_IN
        INSTALLMENT_PURCHASE
    }
    class AccountType {
        <<enumeration>>
        SAVINGS
        CHECKING
        CREDIT_CARD
    }
    class AccountFactory {
        <<factory>>
        +create(type, initialBalance)$ Account
        +restore(snapshot)$ Account
    }

    %% ===== Dominio: user =====
    class User {
        <<aggregate root>>
        -#name: string
        -#password: string
        -#account: Account
        -#role: UserRole
        -#failedAttempts: number
        -#isLocked: boolean
        -#lockedAt: number
        -#profile: ClientProfile
        +authenticate(password) boolean
        +getLoginStatus() LoginStatus
        +changePassword(newPassword) void
        +unlock() void
        +getName() string
        +getAccount() Account
        +getProfile() ClientProfile
        +getRole() UserRole
        +isLocked() boolean
        +getFailedAttempts() number
        +toSnapshot() object
        +restore(snapshot, account)$ User
    }
    class UserRole {
        <<enumeration>>
        GERENTE
        CLIENTE
    }
    class ClientProfile {
        <<value object>>
        -#fullName: FullName
        -#identification: Identification
        -#phone: MobilePhone
        +getFullName() FullName
        +getIdentification() Identification
        +getPhone() MobilePhone
        +toSnapshot() object
        +restore(snapshot)$ ClientProfile
    }
    class FullName {
        <<value object>>
        -#value: string
        +getValue() string
    }
    class Identification {
        <<value object>>
        -#type: IdentificationType
        -#number: string
        +getType() IdentificationType
        +getNumber() string
        +key() string
        +equals(other) boolean
    }
    class IdentificationType {
        <<enumeration>>
        CEDULA
        PASSPORT
    }
    class MobilePhone {
        <<value object>>
        -#number: string
        +getNumber() string
    }

    %% ===== Dominio: registration =====
    class RegistrationRequest {
        <<entity>>
        -#name: string
        -#password: string
        -#accountType: AccountType
        -#initialBalance: number
        -#profile: ClientProfile
        -#createdAt: Date
        +getName() string
        +getPassword() string
        +getAccountType() AccountType
        +getInitialBalance() number
        +getProfile() ClientProfile
        +getCreatedAt() Date
        +toSnapshot() object
        +restore(snapshot)$ RegistrationRequest
    }

    %% ===== Dominio: errores =====
    class DomainError {
        <<abstract>>
        +errorCode()* string
        +throwError() string
    }

    class AccountInvalidAmountError
    class SameAccountTransferError
    class InvalidInstallmentsError
    class PaymentExceedsDebtError
    class InstallmentsNotSupportedError
    class AccountNotEnoughtFundsError
    class CreditLimitExceededError
    class InvalidAccountTypeError
    class MonthlyStatementNotSupportedError
    class AccountLockedError
    class DeletionNotConfirmedError
    class FullNameInvalidError
    class IdentificationAlreadyRegisteredError
    class InvalidAccountError
    class InvalidCredentialsError
    class InvalidIdentificationError
    class InvalidPhoneError
    class ManagerProtectedError
    class PasswordMismatchError
    class UserAlreadyExistsError
    class UserHasOpenBalanceError
    class UserNameRequiredError
    class UserNotFoundError
    class UserPasswordRequiredError
    class RegistrationRequestAlreadyExistsError
    class RegistrationRequestNotFoundError
    class AmountInvalidError

    %% ===== Aplicación: puertos =====
    class AccountRepository {
        <<interface>>
        +findById(id) Account
        +save(id, account) void
        +delete(id) void
    }
    class UserRepository {
        <<interface>>
        +findByName(name) User
        +save(user) void
        +exists(name) boolean
        +findAll() User[]
        +delete(name) void
        +existsByIdentification(identification) boolean
    }
    class RegistrationRequestRepository {
        <<interface>>
        +findByName(name) RegistrationRequest
        +findAll() RegistrationRequest[]
        +save(request) void
        +delete(name) void
        +findByIdentification(identification) RegistrationRequest
    }

