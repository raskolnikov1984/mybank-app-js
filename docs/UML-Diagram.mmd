classDiagram
    direction TB

    class Dinero {
        <<value object>>
        -_centavos: number
        +sumar(otro: Dinero): Dinero
        +restar(otro: Dinero): Dinero
        +esMayorQue(otro: Dinero): boolean
        +esPositivo(): boolean
        +monto(): number
    }

    class Movimiento {
        <<value object>>
        -_fechaHora: Date
        -_concepto: string
        -_monto: Dinero
        -_saldoResultante: Dinero
        +fechaHora(): Date
        +concepto(): string
        +monto(): Dinero
        +saldoResultante(): Dinero
    }

    class Rol {
        <<value object>>
        -_valor: string
        +esCliente(): boolean
        +esAdmin(): boolean
    }

    class Account {
        <<abstract>>
        -#balance: Money
        -#creditUsed: Money
        -#movements: Movement[]
        +withdrawFunds(amount: Money): void
        +depositFunds(amount: Money): void
        +getBalance(): Money
        +getCreditUsed(): Money
        +getAvailableCredit(): Money
        +getMovements(): Movement[]
        +accountType()* string
        +typeName()* string
        +creditLimit()* Money
        +supportsMonthlyStatement(): boolean = false
        +monthlyStatement(): StatementResult
        +describe()* string
        +hasOpenPosition(): boolean
        +insufficientFundsError(): DomainError
    }

    class SavingsAccount {
        <<CuentaAhorros>>
        +creditLimit(): Money = 0
        +withdrawFunds(amount): credits 1.5% interest first
    }

    class CheckingAccount {
        <<CuentaCorriente>>
        +creditLimit(): Money = 20% of current balance
    }

    class CreditCard {
        <<TarjetaCredito>>
        -#limit: Money
        +getDebt(): Money
        +creditLimit(): Money = credit limit
        +supportsMonthlyStatement(): boolean = true
        +monthlyStatement(): 2% interest on debt
        +insufficientFundsError(): CreditLimitExceededError
    }

    class AccountFactory {
        +create(type, initialBalance)$ Account
    }

    class Usuario {
        <<entity>>
        -_id: string
        -_nombreCompleto: string
        -_nombreUsuario: string
        -_hashClave: string
        -_account: Account
        -_rol: Rol
        -_profile: ClientProfile
        +getAccount(): Account
        +obtenerRol(): Rol
        +changePassword(newPassword): void
        +unlock(): void
        +authenticate(password): boolean
        +getLoginStatus(): LoginStatus
        +getProfile(): ClientProfile
    }

    class ClientProfile {
        <<value object>>
        +getFullName(): string
        +getIdentification(): Identification
        +getPhone(): string
    }

    class Identification {
        <<value object>>
        +getType(): IdentificationType
        +getNumber(): string
        +key(): string
    }

    class RegistrationRequest {
        <<entity>>
        +getProfile(): ClientProfile
        +getAccountType(): string
        +getInitialBalance(): number
    }

    class DomainError {
        <<abstract>>
        -message: string
        -code: string
    }

    class SaldoInsuficienteError
    class CreditLimitExceededError
    class InvalidAccountTypeError
    class MonthlyStatementNotSupportedError
    class UserAlreadyExistsError
    class UserHasOpenBalanceError
    class DeletionNotConfirmedError
    class ManagerProtectedError
    class InvalidIdentificationError
    class FullNameInvalidError
    class InvalidPhoneError
    class PasswordMismatchError
    class IdentificationAlreadyRegisteredError
    class CuentaBloqueadaError
    class MontoInvalidoError

    Account <|-- SavingsAccount
    Account <|-- CheckingAccount
    Account <|-- CreditCard
    AccountFactory ..> Account : creates
    Account "1" *-- "*" Movimiento : registra
    Usuario "1" *-- "1" Account : tiene
    Account ..> Dinero : usa
    Movimiento ..> Dinero : usa
    Usuario ..> Rol : tiene
    DomainError <|-- SaldoInsuficienteError
    DomainError <|-- CuentaBloqueadaError
    DomainError <|-- MontoInvalidoError
    DomainError <|-- CreditLimitExceededError
    DomainError <|-- InvalidAccountTypeError
    DomainError <|-- MonthlyStatementNotSupportedError
    DomainError <|-- UserAlreadyExistsError
    DomainError <|-- UserHasOpenBalanceError
    DomainError <|-- DeletionNotConfirmedError
    DomainError <|-- ManagerProtectedError
    DomainError <|-- InvalidIdentificationError
    DomainError <|-- FullNameInvalidError
    DomainError <|-- InvalidPhoneError
    DomainError <|-- PasswordMismatchError
    DomainError <|-- IdentificationAlreadyRegisteredError
    Usuario "1" o-- "0..1" ClientProfile : tiene
    ClientProfile ..> Identification : usa
    RegistrationRequest "1" *-- "1" ClientProfile : contiene
