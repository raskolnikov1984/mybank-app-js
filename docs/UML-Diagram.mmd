    %% ===== Infraestructura =====
    class InMemoryAccountRepository
    class InMemoryUserRepository
    class InMemoryRegistrationRequestRepository
    class LocalStorageAccountRepository
    class LocalStorageUserRepository
    class LocalStorageRegistrationRequestRepository
    class JsonStorage {
        +read() any
        +write(data) void
    }
    class ConsolePrompt {
        +ask(question) string
        +show(message) void
        +showError(message) void
        +clear() void
        +close() void
    }
    class Container {
        <<composition root>>
        +getContainer()$ object
    }

    %% ===== Relaciones: dominio =====
    Account <|-- SavingsAccount
    Account <|-- CheckingAccount
    Account <|-- CreditCard
    Account "1" *-- "*" Movement : registra
    Account ..> Money : usa
    Movement ..> Money : usa
    Movement ..> MovementType
    Money ..> Currency
    Account ..> AccountType
    AccountFactory ..> Account : crea
    User "1" *-- "1" Account : tiene
    User ..> UserRole
    User "1" o-- "0..1" ClientProfile : perfil
    ClientProfile *-- FullName
    ClientProfile *-- Identification
    ClientProfile *-- MobilePhone
    Identification ..> IdentificationType
    RegistrationRequest "1" *-- "1" ClientProfile : contiene
    RegistrationRequest ..> AccountType
    CreditCard ..> CreditLimitExceededError
    DomainError <|-- AccountInvalidAmountError
    DomainError <|-- SameAccountTransferError
    DomainError <|-- InvalidInstallmentsError
    DomainError <|-- PaymentExceedsDebtError
    DomainError <|-- InstallmentsNotSupportedError
    DomainError <|-- AccountNotEnoughtFundsError
    DomainError <|-- CreditLimitExceededError
    DomainError <|-- InvalidAccountTypeError
    DomainError <|-- MonthlyStatementNotSupportedError
    DomainError <|-- AccountLockedError
    DomainError <|-- DeletionNotConfirmedError
    DomainError <|-- FullNameInvalidError
    DomainError <|-- IdentificationAlreadyRegisteredError
    DomainError <|-- InvalidAccountError
    DomainError <|-- InvalidCredentialsError
    DomainError <|-- InvalidIdentificationError
    DomainError <|-- InvalidPhoneError
    DomainError <|-- ManagerProtectedError
    DomainError <|-- PasswordMismatchError
    DomainError <|-- UserAlreadyExistsError
    DomainError <|-- UserHasOpenBalanceError
    DomainError <|-- UserNameRequiredError
    DomainError <|-- UserNotFoundError
    DomainError <|-- UserPasswordRequiredError
    DomainError <|-- RegistrationRequestAlreadyExistsError
    DomainError <|-- RegistrationRequestNotFoundError
    DomainError <|-- AmountInvalidError

